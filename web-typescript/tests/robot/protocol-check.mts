/**
 * Byte-for-byte comparison of src/engine/serial/protocol.ts against frames
 * generated by pymycobot 4.0.6 itself (see README "Protocol provenance").
 * Run with: npm run check:protocol
 */
import assert from 'node:assert/strict';
import {
  GripperState,
  JOINT_COUNT,
  Opcode,
  angleToInt,
  buildFrame,
  decodeAngles,
  decodeSingle,
  encodeInt16,
  scanFrames,
  toHex,
} from '../../src/engine/serial/protocol';

/** Reference frames emitted by pymycobot's own DataProcessor._mesg. */
const REFERENCE: Record<string, string> = {
  is_controller_connected: 'FE FE 02 14 FA',
  power_on: 'FE FE 02 10 FA',
  power_off: 'FE FE 02 11 FA',
  is_power_on: 'FE FE 02 12 FA',
  release_all_servos: 'FE FE 02 13 FA',
  get_angles: 'FE FE 02 20 FA',
  send_angles: 'FE FE 0F 22 00 00 EE 3A 23 28 04 D2 C3 74 46 50 32 FA',
  send_angle_j3: 'FE FE 06 21 03 DC D8 1E FA',
  gripper_open: 'FE FE 04 66 00 32 FA',
  gripper_close: 'FE FE 04 66 01 32 FA',
  gripper_release: 'FE FE 04 66 FE 32 FA',
  get_gripper_value: 'FE FE 02 65 FA',
  is_gripper_moving: 'FE FE 02 69 FA',
};

const angles = [0.0, -45.5, 90.0, 12.34, -155.0, 180.0];
const sendAnglesPayload: number[] = [];
for (const a of angles) sendAnglesPayload.push(...encodeInt16(angleToInt(a)));
sendAnglesPayload.push(50);

const actual: Record<string, string> = {
  is_controller_connected: toHex(buildFrame(Opcode.IS_CONTROLLER_CONNECTED)),
  power_on: toHex(buildFrame(Opcode.POWER_ON)),
  power_off: toHex(buildFrame(Opcode.POWER_OFF)),
  is_power_on: toHex(buildFrame(Opcode.IS_POWER_ON)),
  release_all_servos: toHex(buildFrame(Opcode.RELEASE_ALL_SERVOS)),
  get_angles: toHex(buildFrame(Opcode.GET_ANGLES)),
  send_angles: toHex(buildFrame(Opcode.SEND_ANGLES, sendAnglesPayload)),
  send_angle_j3: toHex(buildFrame(Opcode.SEND_ANGLE, [3, ...encodeInt16(angleToInt(-90.0)), 30])),
  gripper_open: toHex(buildFrame(Opcode.SET_GRIPPER_STATE, [GripperState.OPEN, 50])),
  gripper_close: toHex(buildFrame(Opcode.SET_GRIPPER_STATE, [GripperState.CLOSE, 50])),
  gripper_release: toHex(buildFrame(Opcode.SET_GRIPPER_STATE, [GripperState.RELEASE, 50])),
  get_gripper_value: toHex(buildFrame(Opcode.GET_GRIPPER_VALUE)),
  is_gripper_moving: toHex(buildFrame(Opcode.IS_GRIPPER_MOVING)),
};

let failures = 0;
for (const [name, expected] of Object.entries(REFERENCE)) {
  const got = actual[name];
  if (got === expected) {
    console.log(`  ok   ${name.padEnd(24)} ${got}`);
  } else {
    failures += 1;
    console.error(`  FAIL ${name}\n       expected ${expected}\n       actual   ${got}`);
  }
}

// Round-trip: encode six angles, parse them back out of a synthetic reply.
const replyPayload = sendAnglesPayload.slice(0, JOINT_COUNT * 2);
const reply = buildFrame(Opcode.GET_ANGLES, replyPayload);
const { frames, rest } = scanFrames(reply);
assert.equal(frames.length, 1, 'one frame expected');
assert.equal(rest.length, 0, 'no trailing bytes expected');
assert.equal(frames[0].opcode, Opcode.GET_ANGLES);
const decoded = decodeAngles(frames[0].payload);
assert.deepEqual(decoded, angles, 'angle round-trip mismatch');
console.log(`  ok   angle round-trip        ${decoded?.join(', ')}`);

// A payload byte may legitimately equal the 0xFA footer or the 0xFE header;
// the parser must use LEN, never a scan for the footer value.
for (const tricky of [0xfa, 0xfe]) {
  const f = buildFrame(Opcode.GET_ANGLES, [tricky, 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a]);
  const scanned = scanFrames(f);
  assert.equal(scanned.frames.length, 1, `frame with 0x${tricky.toString(16)} payload byte`);
  assert.equal(scanned.frames[0].payload.length, 12);
  assert.equal(scanned.frames[0].payload[0], tricky);
}
console.log('  ok   payload byte 0xFA/0xFE handled by LEN, not by footer scan');

// Leading garbage must be skipped, and a partial tail must be preserved.
const noisy = new Uint8Array([0x00, 0xff, 0xfe, ...buildFrame(Opcode.IS_POWER_ON, [1]), 0xfe, 0xfe, 0x02]);
const noisyScan = scanFrames(noisy);
assert.equal(noisyScan.frames.length, 1, 'one frame recovered from noise');
assert.equal(decodeSingle(noisyScan.frames[0].payload), 1);
assert.equal(noisyScan.rest.length, 3, 'partial frame kept for the next chunk');
console.log('  ok   resync over noise, partial tail preserved');

if (failures > 0) {
  console.error(`\n${failures} frame(s) did not match pymycobot output.`);
  process.exit(1);
}
console.log('\nAll protocol frames match pymycobot 4.0.6 output.');
